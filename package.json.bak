{
  "name": "watchlet",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "serve-window": "parcel serve ui/window/index.html --dist-dir dist/ui/window",
    "serve-sidebar": "parcel serve ui/sidebar/index.html --dist-dir dist/ui/sidebar",
    "serve-overlay": "parcel serve ui/overlay/index.html --dist-dir dist/ui/overlay",
    "build": "rm -rf dist && parcel build .",
    "check": "tsc && eslint . && prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Daniel Franklin <daniel@danielzfranklin.org>",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@parcel/transformer-sass": "^2.8.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "iina-plugin-definition": "^0.0.7",
    "prettier": "^2.8.8",
    "process": "^0.11.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "dependencies": {
    "parcel": "^2.8.3",
    "parcel-optimizer-webview": "git+https://github.com/dzfranklin/parcel-optimizer-webview.git",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "browserslist": "safari >= 9",
  "targets": {
    "main": false,
    "global": {
      "context": "service-worker",
      "distDir": "./dist/",
      "source": "entrypoints/global.ts",
      "outputFormat": "global",
      "optimize": false
    },
    "entry": {
      "context": "service-worker",
      "distDir": "./dist/",
      "source": "entrypoints/index.ts",
      "outputFormat": "global",
      "optimize": false
    },
    "window": {
      "context": "browser",
      "distDir": "./dist/ui/window",
      "source": "ui/window/index.html",
      "publicUrl": "./",
      "outputFormat": "global",
      "optimize": false
    },
    "overlay": {
      "context": "browser",
      "distDir": "./dist/ui/overlay",
      "source": "ui/overlay/index.html",
      "publicUrl": "./",
      "outputFormat": "global",
      "includeNodeModules": true,
      "optimize": false
    },
    "sidebar": {
      "context": "browser",
      "distDir": "./dist/ui/sidebar",
      "source": "ui/sidebar/index.html",
      "publicUrl": "./",
      "outputFormat": "global",
      "optimize": false
    }
  }
}
